{
  "name": "better-auth-fipa-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "turbo run build",
    "check": "pnpm format:check && turbo run build lint typecheck test:coverage package:check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "test:postgres": "turbo run test:postgres --filter=@eventyr-tech/better-auth-fipa",
    "package:check": "turbo run package:check",
    "dev": "turbo run dev",
    "test:ios": "turbo run test:ios",
    "verify:ios-package": "turbo run build --filter=@eventyr-tech/react-native-fipa && node scripts/verify-ios-package.mjs",
    "verify:android-package": "turbo run build --filter=@eventyr-tech/react-native-fipa && node scripts/verify-android-package.mjs",
    "test:android": "pnpm --filter @eventyr-tech/react-native-fipa test:android",
    "verify:android-app": "turbo run build --filter=@eventyr-tech/react-native-fipa && node scripts/verify-android-app.mjs"
  },
  "devDependencies": {
    "prettier": "^3.8.1",
    "turbo": "2.10.13"
  }
}
